{
    "name": "discord-daily-check-bot",
    "version": "2.1.0",
    "private": true,
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/index.js",
        "check:now": "tsx src/run-check.ts",
        "eslint": "eslint src/ --ext .ts,.tsx",
        "eslint:fix": "eslint src/ --ext .ts,.tsx --fix",
        "prettier": "prettier src/ --check",
        "prettier:fix": "prettier src/ --write"
    },
    "dependencies": {
        "discord.js": "^14.20.0",
        "dotenv": "^16.4.5",
        "mysql2": "^3.11.4",
        "node-cron": "^4.1.0",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^22.13.1",
        "eslint": "^10.1.0",
        "prettier": "^3.8.1",
        "tsx": "^4.19.2",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.58.0"
    },
    "engines": {
        "node": ">=20"
    }
}
